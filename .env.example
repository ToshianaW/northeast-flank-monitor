# Copy to .env.local and fill in real values. Never commit .env.local.
# This file is public: put only placeholders here, never real secrets.

# Required. The server refuses to start if this is unset or left as the placeholder.
# Escape a literal "$" as "\$" (Next.js expands $VAR references in env files).
ADMIN_PASSWORD=replace-with-a-strong-password

# Required. Signs admin session cookies; at least 32 random characters. Changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# Postgres (Neon). Use the direct URL for migrations, the pooled URL for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://USER:PASSWORD@HOST-pooler/DBNAME?sslmode=verify-full"

# Anthropic API key for the extractor (npm run extract, step 2.2).
ANTHROPIC_API_KEY=replace-with-your-api-key

# X (Twitter) posting (npm run x:post). Posting needs all four keys AND X_POSTING_ENABLED=true AND --post.
# Create them in the X developer portal with "Read and write" permissions; the access token and
# secret must be generated after switching to Read and write. Never paste real values anywhere else.
X_API_KEY=your-consumer-api-key
X_API_SECRET=your-consumer-api-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_TOKEN_SECRET=your-access-token-secret
X_POSTING_ENABLED=false
X_DAILY_CAP=20
# Public address of the site (no trailing slash), used for the daily digest link in X posts.
PUBLIC_SITE_URL=https://your-site.example
