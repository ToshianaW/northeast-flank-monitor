    "reservist",
    "conscript",
    "readiness",
    "brigade",
    "battalion",
    "battlegroup",
    "deploy",
    "garrison",
    "border guard",
    "border",
    "airspace",
    "air policing",
    "fighter jet",
    "warplane",
    "drone",
    "UAV",
    "air defence",
    "air defense",
    "missile",
    "Iskander",
    "navy",
    "naval",
    "warship",
    "submarine",
    "Baltic Fleet",
    "electronic warfare",
    "GPS jamming",
    "jamming",
    "sabotage",
