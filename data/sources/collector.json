{
  "_comment": "Collector configuration (roadmap step 2.1). Feed and listing 'source' values must match a registry source name exactly. Verified 2026-10-02. Sites that block automated access (kam.lt, kariuomene.lt, reuters.com) and sources with no feed (NATO) are intentionally absent.",
  "user_agent": "NortheastFlankMonitor-collector/0.1",
  "lookback_hours": 48,
  "request_timeout_ms": 20000,
  "per_host_interval_ms": 3000,
  "fetch_full_text": false,
  "keywords": [
    "military",
    "army",
    "armed forces",
    "troops",
    "soldier",
    "defence",
    "defense",
